LittleEndian(); 

// --- Enum Definitions ---

enum <uint32> TLinkPacketFormat {
    FMT_XREQ  = 0,
    FMT_XFC   = 1,
    FMT_XTWRS = 2,
    FMT_XTWRL = 3,
    FMT_XPWRS = 4,
    FMT_XPWRL = 5,
    FMT_XPRDS = 6,
    FMT_XPRDL = 7
};

// --- Packet Structures ---

// Packet: XREQ - 2 words
typedef struct {
    // Word 0 (Bits 0-31)
    uint32 XBITMAP0     : 24 <comment="Shift: 0, Size: 24">;
    uint32 _pad1        : 5; // Gap 24-29
    TLinkPacketFormat FMT : 3 <comment="Shift: 29, Size: 3", fgcolor=cRed>;
    
    // Word 1 (Bits 32-63)
    uint32 XBITMAP1     : 16 <comment="Shift: 32, Size: 16">;
    uint32 _pad2        : 16; // Fill to 32 bits
} XREQ <bgcolor=0xE0F7FA>;

// Packet: XFC - 1 word
typedef struct {
    // Word 0 (Bits 0-31)
    uint32 _pad1        : 14; // Gap 0-14
    uint32 DSTTILEID    : 11 <comment="Shift: 14, Size: 11">;
    uint32 _pad2        : 4;  // Gap 25-29
    TLinkPacketFormat FMT : 3 <comment="Shift: 29, Size: 3", fgcolor=cRed>;
} XFC <bgcolor=0xFFE0B2>;

// Packet: XTWRS - 2 words
typedef struct {
    // Word 0 (Bits 0-31)
    uint32 TILEADDR0    : 13 <comment="Shift: 0, Size: 13">;
    uint32 _pad1        : 1; // Gap 13-14
    uint32 DSTTILEID    : 11 <comment="Shift: 14, Size: 11">;
    uint32 _pad2        : 1; // Gap 25-26
    uint32 PEN          : 1  <comment="Shift: 26, Size: 1">;
    uint32 LAST         : 1  <comment="Shift: 27, Size: 1">;
    uint32 _pad3        : 1; // Gap 28-29
    TLinkPacketFormat FMT : 3 <comment="Shift: 29, Size: 3", fgcolor=cRed>;

    // Word 1 (Bits 32-63)
    uint32 LENGTH       : 4  <comment="Shift: 32, Size: 4">;
    uint32 BCASTBITMAP  : 16 <comment="Shift: 36, Size: 16">;
    uint32 _pad4        : 9; // Gap 52-61
    uint32 TILEADDR1    : 3  <comment="Shift: 61, Size: 3">;
} XTWRS <bgcolor=0xDCEDC8>;

// Packet: XTWRL - 2 words
typedef struct {
    // Word 0
    uint32 TILEADDR0    : 13;
    uint32 _pad1        : 1;
    uint32 DSTTILEID    : 11;
    uint32 _pad2        : 1;
    uint32 PEN          : 1;
    uint32 LAST         : 1;
    uint32 _pad3        : 1;
    TLinkPacketFormat FMT : 3 <fgcolor=cRed>;

    // Word 1
    uint32 LENGTH       : 4;
    uint32 BCASTBITMAP  : 16;
    uint32 _pad4        : 9;
    uint32 TILEADDR1    : 3;
} XTWRL <bgcolor=0xC5E1A5>;

// Packet: XPWRS - 2 words
typedef struct {
    // Word 0
    uint32 _pad1        : 14;
    uint32 SRCTILEID    : 11 <comment="Shift: 14, Size: 11">;
    uint32 _pad2        : 1;
    uint32 PEN          : 1;
    uint32 LAST         : 1;
    uint32 _pad3        : 1;
    TLinkPacketFormat FMT : 3 <comment="Shift: 29, Size: 3", fgcolor=cRed>;

    // Word 1
    uint32 LENGTH       : 4   <comment="Shift: 32, Size: 4">;
    uint32 XADDR        : 28  <comment="Shift: 36, Size: 28">;
} XPWRS <bgcolor=0xF8BBD0>;

// Packet: XPWRL - 2 words
typedef struct {
    // Word 0
    uint32 _pad1        : 14;
    uint32 SRCTILEID    : 11;
    uint32 _pad2        : 1;
    uint32 PEN          : 1;
    uint32 LAST         : 1;
    uint32 _pad3        : 1;
    TLinkPacketFormat FMT : 3 <fgcolor=cRed>;

    // Word 1
    uint32 LENGTH       : 4;
    uint32 XADDR        : 28;
} XPWRL <bgcolor=0xF48FB1>;

// Packet: XPRDS - 2 words
typedef struct {
    // Word 0
    uint32 TILEADDR0    : 13 <comment="Shift: 0, Size: 13">;
    uint32 _pad1        : 1;
    uint32 SRCTILEID    : 11 <comment="Shift: 14, Size: 11">;
    uint32 _pad2        : 1;
    uint32 PEN          : 1;
    uint32 LAST         : 1;
    uint32 _pad3        : 1;
    TLinkPacketFormat FMT : 3 <comment="Shift: 29, Size: 3", fgcolor=cRed>;

    // Word 1
    uint32 LENGTH       : 4   <comment="Shift: 32, Size: 4">;
    uint32 XADDR        : 28  <comment="Shift: 36, Size: 28">;
} XPRDS <bgcolor=0xD1C4E9>;

// Packet: XPRDL - 2 words
typedef struct {
    // Word 0
    uint32 TILEADDR0    : 13;
    uint32 _pad1        : 1;
    uint32 SRCTILEID    : 11;
    uint32 _pad2        : 1;
    uint32 PEN          : 1;
    uint32 LAST         : 1;
    uint32 _pad3        : 1;
    TLinkPacketFormat FMT : 3 <fgcolor=cRed>;

    // Word 1
    uint32 LENGTH       : 4;
    uint32 XADDR        : 28;
} XPRDL <bgcolor=0xB39DDB>;


// --- Main Parsing Logic ---

typedef struct {
    // Peek at the first 32-bit word
    // FMT is at Shift 29 (Bits 29-31) of Word 0
    local uint32 header = ReadUInt(FTell());
    local ubyte fmt = (header >> 29) & 0x7;
    
    switch(fmt) {
        case FMT_XREQ:  XREQ  packet; break;
        case FMT_XFC:   XFC   packet; break;
        case FMT_XTWRS: XTWRS packet; break;
        case FMT_XTWRL: XTWRL packet; break;
        case FMT_XPWRS: XPWRS packet; break;
        case FMT_XPWRL: XPWRL packet; break;
        case FMT_XPRDS: XPRDS packet; break;
        case FMT_XPRDL: XPRDL packet; break;
        default:
            Warning("Unknown Packet Format at offset %Ld", FTell());
            uint32 UnknownPacket;
            break;
    }
} TLinkPacket <read=ReadTLinkPacket>;

string ReadTLinkPacket(TLinkPacket &p) {
    local string s;
    SPrintf(s, "FMT: %d", p.fmt);
    return s;
}

// --- Main Execution ---

while( !FEof() ) {
    TLinkPacket packet;
}